# Ignore logs folder in current directory
logs/
# Ignore logs folder in parent directory
../logs/
# Ignore all .log files in current directory
*.log
# Ignore unwanted files generated by Visual Studio
.vs/
*.user
*.suo
# Ignore build output folders
bin/
obj/
# Ignore .DS_Store files on macOS
.DS_Store
# Ignore .env files that may contain sensitive information
.env